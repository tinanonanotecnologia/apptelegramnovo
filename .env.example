# URL PostgreSQL local de exemplo. Ajuste ao seu ambiente.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Configure estas variáveis no servidor. Nunca use estes placeholders como credenciais reais.
ADMIN_USERNAME=seu_usuario_admin
ADMIN_PASSWORD=defina_uma_senha_forte_e_unica
ADMIN_SESSION_SECRET=gere_uma_chave_aleatoria_com_pelo_menos_32_caracteres

# Firebase Web SDK (Google login do chat)
NEXT_PUBLIC_FIREBASE_API_KEY=seu_api_key_web
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=seu_app_id_web
